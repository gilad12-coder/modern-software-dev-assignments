diff --git a/fsed/tests/test_fsed.py b/fsed/tests/test_fsed.py
index d5fcadd..10d5a9b 100644
--- a/fsed/tests/test_fsed.py
+++ b/fsed/tests/test_fsed.py
@@ -184,0 +185,24 @@ class TestFsed(unittest.TestCase):
+    def test_cli_auto_tsv_unicode(self):
+        '''
+        Checks that the CLI detects a TSV pattern file without
+        --pattern-format and writes a Unicode replacement intact.
+        '''
+        # under sed parsing, "smile\t..." would use "m" as its
+        # delimiter and be skipped
+        pattern_text = 'smile\t☺\nnaive\tnaïve\n'
+        input_text = 'a naive smile\n'
+        temp_paths = []
+        try:
+            for contents in (pattern_text, input_text):
+                fhandle, temp_path = tempfile.mkstemp()
+                temp_paths.append(temp_path)
+                with os.fdopen(fhandle, 'wb') as temp_file:
+                    temp_file.write(contents.encode('utf-8'))
+            exit_code, output, result = click_command_runner(
+                fsed.main, ['-o', '%t'] + temp_paths)
+        finally:
+            for temp_path in temp_paths:
+                os.remove(temp_path)
+        self.assertEqual(exit_code, 0)
+        self.assertEqual(result, 'a naïve ☺\n')
+
